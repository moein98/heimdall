		)))(text "SPINDLE. 0-10 V speed and FWD / REV for the VFD, isolated from this board." (at 12.7 16.51 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "41cc7837-79f6-4039-9c4d-b7154c558628"))(text "Mach3: port 2 pin 7 = spindle PWM, PWMBase Freq 100 Hz. Pin 8 = Output #1 (M3, FWD)," (at 12.7 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "54d5d65a-6403-48df-af16-9f93d2c574d4"))(text "pin 9 = Output #2 (M4, REV). All three active high. Trim RV1 for 10.0 V at full speed." (at 12.7 29.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "272411bc-dded-4fa2-871c-44f52ec1137c"))(rectangle (start 12.7 40.64) (end 190.5 185.42) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "1caad721-0541-4d7f-bc54-fcb803be750d"))(text "BOARD SIDE - PORT 2 TO THE LEDS" (at 15.24 38.1 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "6a734408-2f9b-4178-b075-bb6ab4057d54"))(text "Pulled down, so with the PC off or the cable out every LED is dark:" (at 15.24 48.26 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "89281834-815f-486e-9f1e-c231ccc0bb15"))(text "no speed, no direction. The 74HC14 sinks the LED current, so an LED" (at 15.24 53.34 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d9a3dd99-7290-4904-81ec-b8a5bad15b4e"))(text "lights only when its port pin is high - two inversions, none overall." (at 15.24 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1289d855-e55b-4a2e-a58d-4d0255fe6c23"))(wire (pts (xy 160.02 63.5)(xy 160.02 55.88)) (stroke (width 0) (type default)) (uuid "b87d8672-d91c-49c5-8a60-bfb7ef7761fc"))(global_label "+5V" (shape passive) (at 160.02 55.88 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "637d2299-0c6c-4353-93d4-f1758f46b83f"))(wire (pts (xy 160.02 88.9)(xy 160.02 96.52)) (stroke (width 0) (type default)) (uuid "715ae21e-8c00-43d2-bf6f-43b05449b6d9"))(global_label "GND" (shape passive) (at 160.02 96.52 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid 