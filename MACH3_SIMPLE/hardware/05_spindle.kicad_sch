		)))(text "SPINDLE. 0-10 V speed and FWD / REV for the VFD, isolated from this board." (at 12.7 16.51 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "9515babb-5f1b-4de1-86ad-531105ece86b"))(text "Mach3: port 2 pin 7 = spindle PWM, PWMBase Freq 100 Hz. Pin 8 = Output #1 (M3, FWD)," (at 12.7 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1bede319-8d6a-44b4-8a2b-dd9f79d02311"))(text "pin 9 = Output #2 (M4, REV). All three active high. Trim RV1 for 10.0 V at full speed." (at 12.7 29.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f29e2085-0cd4-4e96-becc-87c1c01f1f6b"))(rectangle (start 12.7 40.64) (end 190.5 185.42) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "11210269-fb3f-419a-8421-73f258012868"))(text "BOARD SIDE - PORT 2 TO THE LEDS" (at 15.24 38.1 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "638f3232-c0ad-4206-8992-418f238da068"))(text "Pulled down, so with the PC off or the cable out every LED is dark:" (at 15.24 48.26 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5f2b2dde-0da4-4e00-8c69-abb50068feba"))(text "no speed, no direction. The 74HC14 sinks the LED current, so an LED" (at 15.24 53.34 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "da85d156-5028-4df8-8be3-3a65084f3d44"))(text "lights only when its port pin is high - two inversions, none overall." (at 15.24 58.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a82c681e-af7b-4158-9ef9-c203a27eb825"))(wire (pts (xy 160.02 63.5)(xy 160.02 55.88)) (stroke (width 0) (type default)) (uuid "f724cf90-ee8f-4a77-b0e4-4a2f20fa7f19"))(global_label "+5V" (shape passive) (at 160.02 55.88 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0a34ba81-4779-4a81-8187-4331e2758873"))(wire (pts (xy 160.02 88.9)(xy 160.02 96.52)) (stroke (width 0) (type default)) (uuid "89899a1c-9789-4e93-87e4-67d1bb0f180e"))(global_label "GND" (shape passive) (at 160.02 96.52 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid 