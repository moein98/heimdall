	))(text "INPUTS. 24 V sensors on optocouplers, handwheel straight through." (at 12.7 16.51 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "8eafd690-7acf-4ada-8e24-458ce7f3e5b7"))(text "EVERY optocoupler LED gets an anti-parallel diode. A PC847 LED is rated" (at 12.7 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "cd4a5e67-e319-459d-9cf1-2e361af61767"))(text "6 V reverse and a sensor cable beside a motor lead delivers far more." (at 12.7 29.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b82b0fe5-6aab-466b-a54f-da0f7ca2760d"))(text "That is the most likely reason optocouplers keep dying, and the fix is" (at 12.7 34.29 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "37a60236-f23c-4d6d-b285-10ce17203802"))(text "one diode each." (at 12.7 39.37 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "06fc7f1e-d890-44fd-b218-16b456cbb47f"))(wire (pts (xy 33.02 144.78)(xy 25.4 144.78)) (stroke (width 0) (type default)) (uuid "508b55e9-3e1e-4f75-a0f3-13ea807ba12d"))(global_label "GND" (shape passive) (at 25.4 144.78 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "73ea4a62-7dab-4db7-9909-74a13cea2511"))(wire (pts (xy 33.02 149.86)(xy 25.4 149.86)) (stroke (width 0) (type default)) (uuid "2aae16a1-143b-4e81-a1df-3912c7b8847d"))(global_label "GND" (shape passive) (at 25.4 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b5456551-eee2-4a61-b299-438fe64756b8"))(wire (pts (xy 33.02 154.94)(xy 25.4 154.94)) (stroke (width 0) (type default)) (uuid "afa89155-1aae-4bee-84a0-01ee3457da0a"))(global_label "GND" (shape passive) (at 25.4 154.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "560e79c8-9e4c-4e35-b4ae-84501d23b336"))(wire (pts (xy 33.02 160.02)(xy 25.4 160.02)) (stroke (width 0) (type default)) (uuid "e1eacb93-bb9e-4463-9200-dca5cbd95444"))(global_label "GND" (shape passive) (at 25.4 160.02 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "93e0a0cb-88cc-4fe7-9186-cdda406a82