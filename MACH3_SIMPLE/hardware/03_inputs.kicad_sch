pe passive) (at 304.8 274.32 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid "78e5ec9b-dcba-4e91-93a7-968d081a1e2f"))(wire (pts (xy 342.9 259.08)(xy 342.9 251.46)) (stroke (width 0) (type default)) (uuid "b419a2be-5ca5-46d8-886c-53a275aeb064"))(global_label "MPG_B_PC" (shape passive) (at 342.9 251.46 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "62bc0a1a-5730-4a0a-b5f6-8463ef570043"))(wire (pts (xy 342.9 266.7)(xy 342.9 274.32)) (stroke (width 0) (type default)) (uuid "aae2069b-19af-40eb-8217-4ca5c8f1a895"))(global_label "+5V" (shape passive) (at 342.9 274.32 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bc9142fa-117d-47e3-8117-24bdb9ad977a"))(rectangle (start 114.3 294.64) (end 396.24 375.92) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "8179d7bd-d1db-4a28-8dc1-efc5074436f9"))(text "HANDWHEEL ROUTING - JOG OR THC, CHOSEN BY SendSerial" (at 116.84 292.1 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "7da494aa-d539-4b2e-bf03-2b0a5c426da5"))(text "One encoder, two jobs. U3 sends MPG A and B either to port 2 pins 12" (at 116.84 302.26 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b07074b4-456d-4519-8630-8a1bbf85d1c3"))(text "and 13, where Mach3 reads them as the handwheel, or to pins 10 and 11," (at 116.84 307.34 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bc5b7cac-e5c0-4860-8cc7-32f4dbc56a33"))(text "where it reads them as THC up and down. The MCU picks, on SendSerial" (at 116.84 312.42 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e6680f3b-c0ef-462d-8e2d-cb1a0e9ed062"))(text "'T' for THC and 't' for jog, so it is one more macro alongside the relays." (at 116.84 317.5 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b4c13350-8da1-408c-b10a-040603731596"))(text "The four LPT pins are pulled up, so whichever pair is not selected sits" (at 116.84 325.12 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7cb2f033-4d93-49e8-83ba-765d239a10e0"))(text "high and inactive rather than floating." (at 116.84 330.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0098f024-79c4-4db3-ab6a-2645d48bfe6d"))(wire (pts (xy 228.6 335.28)(xy 228.6 327.66)) (stroke (width 0) (type default)) (uuid "661487db-b188-484a-9aad-8a247883ff66"))(global_label "+5V" (shape passive) (at 228.6 327.66 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9e15a5dd-88e3-473f-bfc5-a5556b999151"))(wire (pts (xy 228.6 381)(xy 228.6 388.62)) (stroke (width 0) (type default)) (uuid "f385d56a-e752-4b1f-8c4c-1460a2523b75"))(global_label "GND" (shape passive) (at 228.6 388.62 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid "03072c8d-1ce2-4d09-aa2d-fc21b02ccc5e"))(wire (pts (xy 231.14 381)(xy 231.14 388.62)) (stroke (width 0) (type default)) (uuid "572a5ff0-f266-4f6d-8960-dd58a204962d"))(global_label "GND" (shape passive) (at 231.14 388.62 270) (effects (font (size 1.27 1.27)) (justify left)) (uuid "c6eb218c-4b03-4cc1-b9b5-06d8b883123b"))(wire (pts (xy 215.9 365.76)(xy 208.28 365.76)) (stroke (width 0) (type default)) (uuid "89fd9ed1-cda5-4e07-bacb-326a9f11cb36"))(global_label "GND" (shape passive) (at 208.28 365.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1e7c56bf-babd-49c6-aa6a-565976621a99"))(wire (pts (xy 215.9 368.3)(xy 208.28 368.3)) (stroke (width 0) (type default)) (uuid "99ff4e07-7f53-463c-ad32-d21a68237fbd"))(global_label "MPG_SEL" (shape passive) (at 208.28 368.3 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "224fb37c-b2c4-41de-80ad-f1af5de2ca0f"))(wire (pts (xy 215.9 370.84)(xy 208.28 370.84)) (stroke (width 0) (type default)) (uuid "748e56fe-014f-435f-9fee-fbe4436afdf7"))(global_label "MPG_SEL" (shape passive) (at 208.28 370.84 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6e795bb5-6ddd-4656-9b66-bb037a43056b"))(wire (pts (xy 215.9 373.38)(xy 208.28 373.38)) (stroke (width 0) (type default)) (uuid "6bd39db2-8a3f-40f9-81de-d4af037ed744"))(global_label "GND" (shape passive) (