	))(text "INPUTS. 24 V sensors on optocouplers, handwheel straight through." (at 12.7 16.51 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "dd8074e2-21c7-4de4-9e49-cc910b93a0ca"))(text "EVERY optocoupler LED gets an anti-parallel diode. A PC847 LED is rated" (at 12.7 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "481a573a-b33f-44b9-8fa0-706bfad6f78a"))(text "6 V reverse and a sensor cable beside a motor lead delivers far more." (at 12.7 29.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5c4ac5b6-d1fc-483c-b662-8e237c9021b0"))(text "That is the most likely reason optocouplers keep dying, and the fix is" (at 12.7 34.29 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7312b6b3-ff1b-4a9f-a4f5-2ff212d34ec9"))(text "one diode each." (at 12.7 39.37 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "384a9787-fe31-4fcf-a5fb-2783298ff5dc"))(wire (pts (xy 33.02 144.78)(xy 25.4 144.78)) (stroke (width 0) (type default)) (uuid "8a7a9471-387b-47d2-b550-25d1172e7c46"))(global_label "GND" (shape passive) (at 25.4 144.78 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "93fc1b40-7ec4-4951-9732-44f218c97408"))(wire (pts (xy 33.02 149.86)(xy 25.4 149.86)) (stroke (width 0) (type default)) (uuid "4e5f1ec1-f0e6-4ede-b4c9-696fe8d596e3"))(global_label "GND" (shape passive) (at 25.4 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9d69d8b3-ff17-4b44-9631-2a2029629453"))(wire (pts (xy 33.02 154.94)(xy 25.4 154.94)) (stroke (width 0) (type default)) (uuid "7671873c-153b-4020-8b73-1bf34077a7d7"))(global_label "GND" (shape passive) (at 25.4 154.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6b20cef8-4499-47c9-97bb-91fe9bba644a"))(wire (pts (xy 33.02 160.02)(xy 25.4 160.02)) (stroke (width 0) (type default)) (uuid "f7f52802-4f20-4b45-873d-cb35f1d12da1"))(global_label "GND" (shape passive) (at 25.4 160.02 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6a1c9c54-e61f-4168-b3ca-257278b5bd