	))(text "INPUTS. 24 V sensors on optocouplers, handwheel straight through." (at 12.7 16.51 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "4edbe8d3-7560-4b8a-843f-927faecfa33e"))(text "EVERY optocoupler LED gets an anti-parallel diode. A PC847 LED is rated" (at 12.7 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "08159e3c-d315-4afb-8dc7-7b983f615e3e"))(text "6 V reverse and a sensor cable beside a motor lead delivers far more." (at 12.7 29.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "c83761ae-3bc8-4625-8eb9-aec1f20d6af7"))(text "That is the most likely reason optocouplers keep dying, and the fix is" (at 12.7 34.29 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2a698224-aff3-46de-a05f-a38c8c3048de"))(text "one diode each." (at 12.7 39.37 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a45aa768-5ec3-4dee-a6d8-bf3cd850bdc9"))(wire (pts (xy 33.02 144.78)(xy 25.4 144.78)) (stroke (width 0) (type default)) (uuid "42388333-a9d8-4c5d-910d-ef38284442c6"))(global_label "GND" (shape passive) (at 25.4 144.78 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "44944a94-e6cc-4e6a-991f-8268820dfbde"))(wire (pts (xy 33.02 149.86)(xy 25.4 149.86)) (stroke (width 0) (type default)) (uuid "bbc93660-4e89-40fa-8fb5-64639c77d4ef"))(global_label "GND" (shape passive) (at 25.4 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ca8e4dcc-c0df-486e-8877-fd8dea7dd682"))(wire (pts (xy 33.02 154.94)(xy 25.4 154.94)) (stroke (width 0) (type default)) (uuid "0641660f-4a8f-4389-845a-f9520684a4cd"))(global_label "GND" (shape passive) (at 25.4 154.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4f986832-5f3e-42df-b418-6077976d88b8"))(wire (pts (xy 33.02 160.02)(xy 25.4 160.02)) (stroke (width 0) (type default)) (uuid "a6fd6fa1-037a-4b1f-9851-bdcb2abf626d"))(global_label "GND" (shape passive) (at 25.4 160.02 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "fa9d581c-0c88-42e2-b826-eba029ce05