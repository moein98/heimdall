					(name "KLC_S4.2_DVDD") "Not a standalone power converter; internal on-chip voltage regulator for digital core supply; DVDD is the digital core power supply, should be placed next to voltage regulator output.")
				(field
					(name "KLC_S4.2_VREG_LX") "Should be placed next to DVDD.")
			)
